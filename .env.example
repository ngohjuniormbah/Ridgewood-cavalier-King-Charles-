# ---------------------------------------------------------------------------
# Ridgewood Cavalier King Charles — environment variables
# Copy this file to `.env.local` for local development, and set the same
# values in your Vercel Project Settings → Environment Variables.
# ---------------------------------------------------------------------------

# Password for the admin dashboard (reachable only at /admin — never linked).
ADMIN_PASSWORD=change-me-to-a-long-secret

# Secret used to sign the admin session cookie. Use a long random string.
ADMIN_SESSION_SECRET=change-me-to-a-different-long-secret

# ---------------------------------------------------------------------------
# Supabase (add these AFTER the site is live on Vercel, when you are ready to
# persist admin content in the cloud). Until these are set, content is served
# from the bundled seed data and local uploads work in development.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Public site URL (used for canonical links, sitemap and Open Graph tags).
NEXT_PUBLIC_SITE_URL=https://ridgewoodcavaliers.com
